# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

COPY . .

# Built without the sar feature, so this is the standalone local-token image.
# ENROLLMENT_AUTHZ=kube needs a separate --features sar build that links the
# Kubernetes client. Keeping it out here matches the service's Kubernetes-free
# default and keeps the image small.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment --bin enrollment \
    && cp target/release/enrollment /usr/local/bin/enrollment

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid enrollment service" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/enrollment /usr/local/bin/enrollment

USER 100:101

EXPOSE 8443

ENTRYPOINT ["enrollment"]
